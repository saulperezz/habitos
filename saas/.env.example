# Supabase › Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# URL pública de la app (enlaces mágicos y redirecciones de auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: rate limiting distribuido (Upstash Redis REST). Sin estas variables se usa un límite en memoria por instancia.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Clave pública VAPID (base64url). La privada solo va en los secrets de Supabase.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
